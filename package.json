{
  "name": "ai-interview-coach",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "npm install && npm --prefix server install && node scripts/setup.mjs",
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "start:server": "npm --prefix server start",
    "start": "node server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "dev:all": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev\"",
    "prod": "vite build && vite preview",
    "start:all": "vite build && concurrently -n server,web -c blue,green \"npm run start:server\" \"vite preview\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.10.1",
    "react-webcam": "^7.0.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "vite": "^7.3.6"
  }
}
