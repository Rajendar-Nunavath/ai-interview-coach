# Copy to server/.env  (or run `npm run setup`, which generates JWT_SECRET for you)
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Get a key at https://aistudio.google.com/apikey  (leave empty for demo mode without AI)

# Set to 1 when deployed behind a reverse proxy / load balancer
# TRUST_PROXY=1
